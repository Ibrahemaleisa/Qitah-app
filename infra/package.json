{
  "name": "@qitah/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK v2 infrastructure for Qitah (staging + production)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "synth": "cdk synth --quiet",
    "synth:staging": "cdk synth --quiet -c env=staging",
    "synth:production": "cdk synth --quiet -c env=production",
    "cdk": "cdk"
  },
  "dependencies": {
    "aws-cdk-lib": "2.273.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1146.1",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
