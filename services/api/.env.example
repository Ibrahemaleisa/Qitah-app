# Local development defaults. Copy to .env (git-ignored). Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://qitah:qitah@127.0.0.1:5432/qitah?schema=public
PUBLIC_BASE_URL=http://127.0.0.1:4000
# local = API-issued JWTs + sandbox OTP; cognito = verify Amazon Cognito tokens
AUTH_MODE=local
JWT_SECRET=dev-only-change-me-at-least-32-characters-long
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_IDS=
# Sandbox providers. Production refuses to boot with sandbox providers unless ALLOW_SANDBOX_IN_PRODUCTION=true.
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=dev-sandbox-webhook-secret
CARRIER_PROVIDER=sandbox
CARRIER_WEBHOOK_SECRET=dev-sandbox-carrier-secret
# Comma-separated origins allowed for browser calls (Expo web dev). Portals use a server-side BFF.
CORS_ORIGINS=http://localhost:8081
# Optional: SQS queue for background jobs (worker). Empty = Postgres outbox polling.
JOBS_QUEUE_URL=
AWS_REGION=me-central-1
