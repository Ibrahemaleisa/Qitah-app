// Qitah marketplace — single source of truth.
// Money is always integer SAR halalas (minor units). Prices are VAT-inclusive.
// Additional CHECK constraints live in migrations (see *_constraints/migration.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────── identity & access

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  OPS_AGENT
  OPS_ADMIN
  FINANCE
}

enum MerchantRole {
  OWNER
  MANAGER
  STAFF
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  phone        String?    @unique
  email        String?    @unique
  name         String?
  passwordHash String?
  cognitoSub   String?    @unique
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  platformRoles PlatformRoleAssignment[]
  memberships   MerchantMember[]
  sessions      AuthSession[]
  vehicles      GarageVehicle[]
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  returnCases   ReturnCase[]
  notifications Notification[]
}

model PlatformRoleAssignment {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ───────────────────────────────────────────── vehicles

model VehicleMake {
  id     String         @id
  nameAr String
  nameEn String
  models VehicleModel[]
}

model VehicleModel {
  id       String           @id
  makeId   String
  nameAr   String
  nameEn   String
  yearFrom Int
  yearTo   Int
  trims    String[]
  engines  String[]
  make     VehicleMake      @relation(fields: [makeId], references: [id])
  fitments ProductFitment[]
  garage   GarageVehicle[]

  @@index([makeId])
}

model GarageVehicle {
  id        String       @id @default(cuid())
  userId    String
  modelId   String
  year      Int
  /// Not used by fitment; optional in the API (defaults to "").
  trim      String       @default("")
  engine    String
  vin       String?
  createdAt DateTime     @default(now())
  deletedAt DateTime?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  model     VehicleModel @relation(fields: [modelId], references: [id])

  // garage/maintenance (see the "garage, maintenance, mechanic reviews" section)
  odometerKm           Int?
  odometerUpdatedAt    DateTime?
  serviceRecords       VehicleServiceRecord[]
  maintenanceReminders MaintenanceReminder[]

  @@index([userId, deletedAt])
}

// ───────────────────────────────────────────── catalog

enum PartOrigin {
  OEM
  AFTERMARKET
}

enum Handling {
  STANDARD
  FRAGILE
  OVERSIZED
  HAZMAT
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum IdentifierType {
  MPN
  OEM
  EAN
}

enum FitmentSource {
  CATALOG
  SELLER
}

model Category {
  id       String    @id
  nameAr   String
  nameEn   String
  art      String
  sort     Int       @default(0)
  products Product[]
}

model Product {
  id                  String        @id @default(cuid())
  nameAr              String
  nameEn              String
  descriptionAr       String        @default("")
  descriptionEn       String        @default("")
  categoryId          String
  brand               String
  origin              PartOrigin
  partNumber          String
  art                 String        @default("pump")
  keywords            String[]
  /// Normalised Arabic/Latin text (names, brand, keywords, part numbers) for search.
  searchText          String        @default("")
  specs               Json          @default("[]")
  universalNoteAr     String?
  universalNoteEn     String?
  weightGrams         Int
  lengthCm            Int
  widthCm             Int
  heightCm            Int
  handling            Handling      @default(STANDARD)
  status              ProductStatus @default(ACTIVE)
  createdByMerchantId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  category    Category            @relation(fields: [categoryId], references: [id])
  identifiers ProductIdentifier[]
  fitments    ProductFitment[]
  offers      Offer[]

  @@index([categoryId, status])
  @@index([partNumber])
  // pg_trgm (extension created in *_search_indexes): serves LIKE '%…%' and word_similarity in /v1/catalog/search.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_searchText_trgm_idx")
}

model ProductIdentifier {
  id         String         @id @default(cuid())
  productId  String
  type       IdentifierType
  value      String
  normalized String
  brand      String?
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type, normalized])
  @@index([normalized])
  // Part-number prefix search (LIKE 'x%') regardless of collation.
  @@index([normalized(ops: raw("text_pattern_ops"))], map: "ProductIdentifier_normalized_pattern_idx")
}

model ProductFitment {
  id                  String        @id @default(cuid())
  productId           String
  modelId             String
  yearFrom            Int
  yearTo              Int
  engines             String[]
  source              FitmentSource
  createdByMerchantId String?
  createdAt           DateTime      @default(now())
  product             Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  model               VehicleModel  @relation(fields: [modelId], references: [id])

  @@index([productId])
  @@index([modelId, yearFrom, yearTo])
}

// ───────────────────────────────────────────── merchants

enum MerchantStatus {
  APPLIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Merchant {
  id                       String            @id @default(cuid())
  legalName                String
  displayNameAr            String
  displayNameEn            String
  crNumber                 String            @unique
  vatNumber                String?
  city                     String
  specialtyAr              String            @default("")
  specialtyEn              String            @default("")
  contactEmail             String
  contactPhone             String
  status                   MerchantStatus    @default(APPLIED)
  /// Merchant-wide negotiated commission (bps). NULL = use the CommissionRule tiers (see "merchant economics").
  commissionBps            Int?
  supportsWorkshopDelivery Boolean           @default(true)
  slaAcceptMinutes         Int               @default(240)
  slaReadyMinutes          Int               @default(1440)
  statusReason             String?
  approvedAt               DateTime?
  approvedById             String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  /// merchant economics: automatic settlement cadence and early payout (with a reserve) for trusted DAILY merchants.
  settlementCadence        SettlementCadence @default(WEEKLY)
  trustedForEarlyPayout    Boolean           @default(false)
  /// Cached 0–100 scorecard score (worker refresh; formula in domain/scorecard.ts). Offer-comparison tiebreaker.
  qualityScore             Int?
  qualityScoreAt           DateTime?

  verifications  MerchantVerification[]
  members        MerchantMember[]
  locations      PickupLocation[]
  offers         Offer[]
  merchantOrders MerchantOrder[]
  settlements    Settlement[]
  ledgerEntries  LedgerEntry[]
  returnCases    ReturnCase[]

  @@index([status])
}

model MerchantVerification {
  id           String             @id @default(cuid())
  merchantId   String
  status       VerificationStatus @default(PENDING)
  documents    Json               @default("[]")
  notes        String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  merchant     Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model MerchantMember {
  id         String       @id @default(cuid())
  merchantId String
  userId     String
  role       MerchantRole
  status     MemberStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([userId])
}

model PickupLocation {
  id                   String             @id @default(cuid())
  merchantId           String
  name                 String
  city                 String
  district             String
  street               String
  contactPhone         String
  latitude             Float?
  longitude            Float?
  /// Same-day cutoff, minutes after midnight Riyadh time (default 14:00). Orders after it miss same-day delivery.
  sameDayCutoffMinutes Int                @default(840)
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  merchant             Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  offers               Offer[]
  groups               FulfillmentGroup[]
  shipments            Shipment[]

  @@index([merchantId])
}

// ───────────────────────────────────────────── offers & inventory

enum Condition {
  NEW
  USED
  REFURBISHED
}

enum OfferStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

enum AdjustmentReason {
  INITIAL
  RESTOCK
  CORRECTION
  DAMAGE
  SALE
  CANCELLATION_RESTOCK
  RETURN_RESTOCK
  IMPORT
}

model Offer {
  id               String          @id @default(cuid())
  merchantId       String
  productId        String
  locationId       String
  sku              String
  condition        Condition       @default(NEW)
  priceHalalas     Int
  compareAtHalalas Int?
  warrantyMonths   Int             @default(0)
  dispatchDaysMin  Int             @default(0)
  dispatchDaysMax  Int             @default(1)
  noteAr           String?
  noteEn           String?
  status           OfferStatus     @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  /// PRIVATE offers come from an accepted part-request quote (see "part requests (RFQ)" at the end):
  /// never listed publicly, purchasable only by `privateForUserId`, and only until the quote's `validUntil`.
  visibility       OfferVisibility @default(PUBLIC)
  privateForUserId String?
  partQuote        PartQuote?
  /// Last time the merchant confirmed stock/price (any stock or price update, CSV import, "confirm all").
  /// Drives the freshness policy: stale after FRESHNESS_STALE_DAYS, hidden after FRESHNESS_HIDE_DAYS.
  lastConfirmedAt  DateTime        @default(now())

  merchant     Merchant               @relation(fields: [merchantId], references: [id])
  product      Product                @relation(fields: [productId], references: [id])
  location     PickupLocation         @relation(fields: [locationId], references: [id])
  inventory    InventoryLevel?
  reservations InventoryReservation[]
  adjustments  InventoryAdjustment[]
  orderItems   OrderItem[]
  cartItems    CartItem[]

  @@unique([merchantId, sku])
  @@index([productId, status])
  @@index([merchantId, status])
  @@index([privateForUserId])
  @@index([merchantId, lastConfirmedAt])
}

/// available = onHand - reserved. Both guarded by CHECK constraints.
model InventoryLevel {
  offerId   String   @id
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model InventoryReservation {
  id          String            @id @default(cuid())
  offerId     String
  orderId     String
  orderItemId String            @unique
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  offer       Offer             @relation(fields: [offerId], references: [id])
  order       Order             @relation(fields: [orderId], references: [id])

  @@index([status, expiresAt])
  @@index([orderId])
}

model InventoryAdjustment {
  id          String           @id @default(cuid())
  offerId     String
  delta       Int
  onHandAfter Int
  reason      AdjustmentReason
  note        String?
  refType     String?
  refId       String?
  actorUserId String?
  createdAt   DateTime         @default(now())
  offer       Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, createdAt])
}

// ───────────────────────────────────────────── customers

enum AddressKind {
  HOME
  WORKSHOP
}

model Address {
  id           String      @id @default(cuid())
  userId       String
  kind         AddressKind
  label        String
  city         String
  district     String
  street       String
  details      String?
  contactName  String
  phone        String
  workshopName String?
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id       String @id @default(cuid())
  cartId   String
  offerId  String
  quantity Int
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offer    Offer  @relation(fields: [offerId], references: [id])

  @@unique([cartId, offerId])
}

// ───────────────────────────────────────────── checkout & shipping quotes

/// Server-computed, priced checkout option. Checkout must reference an unexpired plan.
model CheckoutPlan {
  id              String    @id @default(cuid())
  userId          String
  addressId       String
  strategy        String
  plan            Json
  itemsHalalas    Int
  shippingHalalas Int
  totalHalalas    Int
  sandboxRates    Boolean
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model ShippingQuote {
  id               String   @id @default(cuid())
  carrierCode      String
  serviceCode      String
  originLocationId String
  destinationCity  String
  weightGrams      Int
  parcels          Json
  amountHalalas    Int
  etaDaysMin       Int
  etaDaysMax       Int
  sandbox          Boolean
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([expiresAt])
}

// ───────────────────────────────────────────── orders

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_FULFILLMENT
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
  EXPIRED
}

enum MerchantOrderStatus {
  PENDING_PAYMENT
  NEW
  ACCEPTED
  PACKING
  READY_FOR_PICKUP
  HANDED_OVER
  DELIVERED
  REJECTED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

model Order {
  id               String      @id @default(cuid())
  number           String      @unique
  customerId       String
  status           OrderStatus @default(PENDING_PAYMENT)
  idempotencyKey   String
  checkoutPlanId   String?     @unique
  addressSnapshot  Json
  vehicleSnapshot  Json?
  paymentMethod    String
  itemsHalalas     Int
  shippingHalalas  Int
  discountHalalas  Int         @default(0)
  totalHalalas     Int
  vatHalalas       Int
  refundedHalalas  Int         @default(0)
  currency         String      @default("SAR")
  sandbox          Boolean     @default(true)
  paymentExpiresAt DateTime
  paidAt           DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer       User                   @relation(fields: [customerId], references: [id])
  merchantOrders MerchantOrder[]
  items          OrderItem[]
  groups         FulfillmentGroup[]
  shipments      Shipment[]
  payments       Payment[]
  refunds        Refund[]
  returnCases    ReturnCase[]
  reservations   InventoryReservation[]
  ledgerEntries  LedgerEntry[]

  // organizations (see "organizations (workshops / fleets)" at the end): set only for workshop/fleet orders.
  /// Buying organisation; present = B2B channel (commission rules derive the channel from it).
  buyerOrgId      String?
  /// The workshop's own job / plate reference, printed on its statement.
  workOrderRef    String?
  /// Attribution: the workshop→customer quote this order was converted from.
  workshopQuoteId String?       @unique
  /// NET_TERMS only: when the receivable for this order falls due (paidAt + credit termsDays).
  creditDueAt     DateTime?
  buyerOrg        Organization? @relation(fields: [buyerOrgId], references: [id])

  @@unique([customerId, idempotencyKey])
  @@index([status, createdAt])
  @@index([status, paymentExpiresAt])
  @@index([customerId, createdAt])
  @@index([buyerOrgId, createdAt])
}

model MerchantOrder {
  id                String              @id @default(cuid())
  number            String              @unique
  orderId           String
  merchantId        String
  status            MerchantOrderStatus @default(PENDING_PAYMENT)
  itemsHalalas      Int
  shippingHalalas   Int
  commissionBps     Int
  commissionHalalas Int
  acceptBy          DateTime?
  readyBy           DateTime?
  acceptedAt        DateTime?
  readyAt           DateTime?
  handedOverAt      DateTime?
  deliveredAt       DateTime?
  rejectedReason    String?
  slaBreached       Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order           Order              @relation(fields: [orderId], references: [id])
  merchant        Merchant           @relation(fields: [merchantId], references: [id])
  items           OrderItem[]
  groups          FulfillmentGroup[]
  shipments       Shipment[]
  returnCases     ReturnCase[]
  settlementLines SettlementLine[]

  @@index([merchantId, status, createdAt])
  @@index([orderId])
  @@index([slaBreached, status])
}

model OrderItem {
  id                 String          @id @default(cuid())
  orderId            String
  merchantOrderId    String
  fulfillmentGroupId String
  offerId            String
  productId          String
  quantity           Int
  unitPriceHalalas   Int
  lineTotalHalalas   Int
  productNameAr      String
  productNameEn      String
  partNumber         String
  condition          Condition
  art                String
  status             OrderItemStatus @default(ACTIVE)
  /// Server-computed fit at checkout: {vehicle, status, guaranteed, fitmentIds, vin}. Drives the fit guarantee.
  fitSnapshot        Json?
  /// Commission resolved per line at checkout (category/origin/condition differ within one merchant order).
  /// MerchantOrder.commissionHalalas = Σ lines; refunds reverse commission at the line's rate.
  commissionBps      Int             @default(0)
  commissionHalalas  Int             @default(0)
  /// CommissionRule that matched (null = merchant rate or platform default). Plain column: rules may be edited later.
  commissionRuleId   String?
  createdAt          DateTime        @default(now())

  order         Order            @relation(fields: [orderId], references: [id])
  merchantOrder MerchantOrder    @relation(fields: [merchantOrderId], references: [id])
  group         FulfillmentGroup @relation(fields: [fulfillmentGroupId], references: [id])
  offer         Offer            @relation(fields: [offerId], references: [id])
  returnItems   ReturnItem[]

  @@index([orderId])
  @@index([merchantOrderId])
}

/// A shipping group: items from ONE pickup location to ONE destination that can travel together.
model FulfillmentGroup {
  id               String   @id @default(cuid())
  orderId          String
  merchantOrderId  String
  originLocationId String
  carrierCode      String
  serviceCode      String
  quoteId          String?
  quotedHalalas    Int
  etaDaysMin       Int
  etaDaysMax       Int
  weightGrams      Int
  handling         Handling
  createdAt        DateTime @default(now())

  order          Order          @relation(fields: [orderId], references: [id])
  merchantOrder  MerchantOrder  @relation(fields: [merchantOrderId], references: [id])
  originLocation PickupLocation @relation(fields: [originLocationId], references: [id])
  items          OrderItem[]
  shipments      Shipment[]

  @@index([orderId])
}

// ───────────────────────────────────────────── shipping

enum ShipmentDirection {
  OUTBOUND
  RETURN
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  PICKUP_FAILED
  DELIVERY_FAILED
  EXCEPTION
  CANCELLED
  RETURNED_TO_SENDER
}

/// Who bears a shipment's carrier cost (outbound: the customer paid it at checkout).
enum ShipmentPayer {
  CUSTOMER
  PLATFORM
  MERCHANT
}

enum EventSource {
  CARRIER
  OPS
  MERCHANT
  SYSTEM
}

model Shipment {
  id                 String            @id @default(cuid())
  orderId            String
  merchantOrderId    String
  fulfillmentGroupId String?
  returnCaseId       String?
  originLocationId   String
  direction          ShipmentDirection @default(OUTBOUND)
  carrierCode        String
  serviceCode        String
  sandbox            Boolean
  status             ShipmentStatus    @default(PENDING)
  trackingNumber     String?           @unique
  carrierShipmentId  String?
  labelUrl           String?
  pickupWindowStart  DateTime?
  pickupWindowEnd    DateTime?
  weightGrams        Int
  costHalalas        Int
  paidBy             ShipmentPayer     @default(CUSTOMER)
  exceptionReason    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  order          Order             @relation(fields: [orderId], references: [id])
  merchantOrder  MerchantOrder     @relation(fields: [merchantOrderId], references: [id])
  group          FulfillmentGroup? @relation(fields: [fulfillmentGroupId], references: [id])
  returnCase     ReturnCase?       @relation(fields: [returnCaseId], references: [id])
  originLocation PickupLocation    @relation(fields: [originLocationId], references: [id])
  events         ShipmentEvent[]

  @@index([status, updatedAt])
  @@index([orderId])
  @@index([merchantOrderId])
}

model ShipmentEvent {
  id              String         @id @default(cuid())
  shipmentId      String
  status          ShipmentStatus
  description     String
  location        String?
  source          EventSource
  externalEventId String?        @unique
  actorUserId     String?
  occurredAt      DateTime
  createdAt       DateTime       @default(now())
  shipment        Shipment       @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, occurredAt])
}

// ───────────────────────────────────────────── payments

enum PaymentStatus {
  INITIATED
  CAPTURED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerPaymentId String?
  status            PaymentStatus @default(INITIATED)
  method            String
  amountHalalas     Int
  capturedHalalas   Int           @default(0)
  refundedHalalas   Int           @default(0)
  sandbox           Boolean
  /// Provider fee recorded at capture (PAYMENT_FEES). Sandbox fees come from the configured table and are estimates.
  feeBps            Int           @default(0)
  feeHalalas        Int           @default(0)
  feeEstimated      Boolean       @default(false)
  redirectUrl       String?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order   Order          @relation(fields: [orderId], references: [id])
  events  PaymentEvent[]
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  paymentId       String?
  type            String
  payload         Json
  outcome         String
  createdAt       DateTime @default(now())
  payment         Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  orderId          String
  returnCaseId     String?
  amountHalalas    Int
  reason           String
  status           RefundStatus @default(PENDING)
  providerRefundId String?
  /// Per-merchant split used for ledger postings: [{merchantId, merchantOrderId, items, commission, shipping}]
  allocation       Json         @default("[]")
  failureReason    String?
  idempotencyKey   String       @unique
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment    Payment     @relation(fields: [paymentId], references: [id])
  order      Order       @relation(fields: [orderId], references: [id])
  returnCase ReturnCase? @relation(fields: [returnCaseId], references: [id])

  @@index([orderId])
  @@index([status])
}

// ───────────────────────────────────────────── returns

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  CLOSED
}

model ReturnCase {
  id              String       @id @default(cuid())
  number          String       @unique
  orderId         String
  merchantOrderId String
  merchantId      String
  customerId      String
  status          ReturnStatus @default(REQUESTED)
  reason          String
  customerNote    String?
  decisionNote    String?
  inspectionNote  String?
  restock         Boolean      @default(false)
  refundHalalas   Int          @default(0)
  /// Every line in the case is covered by the fit guarantee (ضمان قطعة).
  guaranteed      Boolean      @default(false)
  /// Private upload keys (customers/<id>/return/...) — required for `damaged`.
  photoKeys       String[]     @default([])
  /// Customer declared the item unopened (required for `changedMind`).
  unopened        Boolean      @default(false)
  inspectedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order         Order         @relation(fields: [orderId], references: [id])
  merchantOrder MerchantOrder @relation(fields: [merchantOrderId], references: [id])
  merchant      Merchant      @relation(fields: [merchantId], references: [id])
  customer      User          @relation(fields: [customerId], references: [id])
  items         ReturnItem[]
  shipments     Shipment[]
  refunds       Refund[]

  @@index([merchantId, status])
  @@index([orderId])
}

model ReturnItem {
  id           String     @id @default(cuid())
  returnCaseId String
  orderItemId  String
  quantity     Int
  returnCase   ReturnCase @relation(fields: [returnCaseId], references: [id], onDelete: Cascade)
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id])

  @@unique([returnCaseId, orderItemId])
}

// ───────────────────────────────────────────── finance

enum LedgerAccount {
  CUSTOMER_CLEARING
  MERCHANT_PAYABLE
  PLATFORM_COMMISSION
  SHIPPING_PAYABLE
  PAYOUTS
  SUSPENSE
  /// Platform-funded fit-guarantee cost (outbound shipping refunded + return shipping).
  GUARANTEE_EXPENSE
  /// Owed by a buying organisation for NET_TERMS orders (debit = the workshop owes Qitah).
  CUSTOMER_RECEIVABLE
  /// Payment-provider fees (platform cost, debit). Credited to CUSTOMER_CLEARING: the PSP nets them from the funds it remits.
  PAYMENT_FEES
  /// Part of a merchant's payable withheld after an early (DAILY) payout until the return window closes.
  MERCHANT_RESERVE
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
}

/// Immutable double-entry ledger: every posting's lines sum to zero.
model LedgerEntry {
  id              String        @id @default(cuid())
  postingId       String
  postingType     String
  account         LedgerAccount
  amountHalalas   Int
  orderId         String?
  merchantId      String?
  merchantOrderId String?
  refType         String
  refId           String
  createdAt       DateTime      @default(now())

  order    Order?    @relation(fields: [orderId], references: [id])
  merchant Merchant? @relation(fields: [merchantId], references: [id])

  @@index([postingId])
  @@index([merchantId, account])
  @@index([merchantOrderId, account])
  @@index([orderId])
}

/// Guards posting idempotency: one posting per (type, ref).
model LedgerPosting {
  id        String   @id @default(cuid())
  type      String
  refId     String
  createdAt DateTime @default(now())

  @@unique([type, refId])
}

model Settlement {
  id                     String           @id @default(cuid())
  merchantId             String
  status                 SettlementStatus @default(DRAFT)
  grossHalalas           Int
  commissionHalalas      Int
  refundsHalalas         Int
  netHalalas             Int
  /// Withheld from early-payout lines (moved to MERCHANT_RESERVE) / released back in RESERVE_RELEASE lines.
  reserveHeldHalalas     Int              @default(0)
  reserveReleasedHalalas Int              @default(0)
  /// Generated by the settlement worker job (vs. by a finance user).
  automatic              Boolean          @default(false)
  payoutReference        String?
  approvedById           String?
  approvedAt             DateTime?
  paidAt                 DateTime?
  createdAt              DateTime         @default(now())

  merchant Merchant         @relation(fields: [merchantId], references: [id])
  lines    SettlementLine[]

  @@index([merchantId, status])
}

model SettlementLine {
  id                String             @id @default(cuid())
  settlementId      String
  merchantOrderId   String
  /// SALE: the order's payable (minus a reserve when paid early). RESERVE_RELEASE: the reserve, net of later refunds.
  kind              SettlementLineKind @default(SALE)
  grossHalalas      Int
  commissionHalalas Int
  refundsHalalas    Int
  netHalalas        Int
  reserveHalalas    Int                @default(0)
  settlement        Settlement         @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  merchantOrder     MerchantOrder      @relation(fields: [merchantOrderId], references: [id])

  @@unique([merchantOrderId, kind])
}

// ───────────────────────────────────────────── notifications, audit, events

enum Audience {
  CUSTOMER
  MERCHANT
  OPS
}

model Notification {
  id         String    @id @default(cuid())
  audience   Audience
  userId     String?
  merchantId String?
  type       String
  title      String
  body       String
  data       Json      @default("{}")
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([merchantId, createdAt])
  @@index([audience, createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorType   String
  merchantId  String?
  action      String
  entityType  String
  entityId    String
  data        Json?
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([entityId])
  @@index([merchantId, createdAt])
  @@index([createdAt])
}

enum OutboxStatus {
  PENDING
  DONE
  FAILED
}

/// Transactional outbox. Written in the same transaction as the state change; drives
/// background jobs (worker / SQS) and realtime streams (SSE).
model DomainEvent {
  id          BigInt       @id @default(autoincrement())
  type        String
  entityType  String
  entityId    String
  orderId     String?
  customerId  String?
  merchantIds String[]
  payload     Json         @default("{}")
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedUntil DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
  @@index([createdAt])
  @@index([customerId, id])
  @@index([merchantIds], type: Gin, map: "DomainEvent_merchantIds_gin")
}

// ───────────────────────────────────────────── garage, maintenance, mechanic reviews

enum MechanicReviewStatus {
  PENDING
  APPROVED
  CHANGES_SUGGESTED
}

enum ServiceRecordSource {
  MANUAL
  ORDER
}

/// "Send to my mechanic": a customer's parts list shared through an unguessable link (no account needed).
/// Only the SHA-256 of the link token is stored. Workshop contact = lead data entered by the mechanic.
model MechanicReview {
  id            String               @id @default(cuid())
  userId        String
  vehicleId     String?
  tokenHash     String               @unique
  status        MechanicReviewStatus @default(PENDING)
  /// {vehicle, lines:[{offerId, productId, qty, nameAr, nameEn, brand, partNumber, condition, fit, alternatives}]}
  snapshot      Json
  note          String?
  /// [{offerId, decision: APPROVED|ALTERNATIVE, text?, partNumber?, offerId?}]
  decisions     Json?
  mechanicNote  String?
  workshopName  String?
  workshopPhone String?
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([workshopPhone])
}

/// Generic maintenance guidance (not manufacturer data). makeId/modelId narrow a template when set.
model MaintenanceTemplate {
  id             String   @id
  serviceCode    String
  makeId         String?
  modelId        String?
  nameAr         String
  nameEn         String
  noteAr         String   @default("")
  noteEn         String   @default("")
  intervalKm     Int?
  intervalMonths Int?
  /// [{code, nameAr, nameEn, intervalKm}] e.g. synthetic vs conventional oil.
  variants       Json     @default("[]")
  /// Parts that make the kit: [{key, nameAr, nameEn, categoryIds, keywords, excludeKeywords?, primary?}]
  components     Json     @default("[]")
  categoryIds    String[]
  keywords       String[]
  sort           Int      @default(0)
  active         Boolean  @default(true)

  @@index([serviceCode])
}

model VehicleServiceRecord {
  id          String              @id @default(cuid())
  vehicleId   String
  serviceCode String
  variant     String?
  doneAtKm    Int?
  doneAt      DateTime
  source      ServiceRecordSource @default(MANUAL)
  orderItemId String?
  createdAt   DateTime            @default(now())
  vehicle     GarageVehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, orderItemId])
  @@index([vehicleId, serviceCode, doneAt])
}

/// Idempotency for maintenance reminders: one in-app notification per vehicle, service and due cycle.
model MaintenanceReminder {
  id          String        @id @default(cuid())
  vehicleId   String
  serviceCode String
  cycleKey    String
  createdAt   DateTime      @default(now())
  vehicle     GarageVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, serviceCode, cycleKey])
}

// ───────────────────────────────────────────── part requests (RFQ)
// "اطلب قطعة": a customer describes a part they cannot find (text, photos, part number, vehicle);
// matching merchants answer with quotes; accepting one creates a PRIVATE Offer for that customer so the
// normal checkout / payment / fulfilment / returns / settlement flow is reused unchanged.
// Customer, merchant, location and product ids are plain columns (validated in services/partRequests.ts)
// so this block does not add back-relations to models other agents edit in parallel.

enum OfferVisibility {
  PUBLIC
  PRIVATE
}

enum PartRequestStatus {
  OPEN
  QUOTED
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum PartQuoteStatus {
  ACTIVE
  WITHDRAWN
  ACCEPTED
  /// Closed without being chosen (another quote won, or the customer cancelled the request).
  DECLINED
  EXPIRED
}

enum PartPreference {
  ANY
  NEW
  USED
  OEM
  AFTERMARKET
}

model PartRequest {
  id                 String            @id @default(cuid())
  number             String            @unique
  customerId         String
  garageVehicleId    String?
  makeId             String
  modelId            String
  year               Int
  engine             String?
  vin                String?
  description        String
  partNumber         String?
  quantity           Int               @default(1)
  /// Private upload keys under customers/<customerId>/part-request/ (served only via short-lived signed URLs).
  photoKeys          String[]
  /// ANY | NEW | USED
  preferredCondition PartPreference    @default(ANY)
  /// ANY | OEM | AFTERMARKET
  preferredOrigin    PartPreference    @default(ANY)
  addressId          String?
  city               String
  status             PartRequestStatus @default(OPEN)
  expiresAt          DateTime
  /// Set once, by the first quote: time-to-first-quote = firstQuotedAt - createdAt (target: ≥70% within 15 min).
  firstQuotedAt      DateTime?
  acceptedQuoteId    String?           @unique
  acceptedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  quotes PartQuote[]

  @@index([customerId, createdAt])
  @@index([status, city])
  @@index([status, makeId])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model PartQuote {
  id              String          @id @default(cuid())
  requestId       String
  merchantId      String
  locationId      String
  /// Existing catalog product, or the DRAFT product created when a free-text quote is accepted.
  productId       String?
  partName        String?
  brand           String?
  partNumber      String?
  categoryId      String?
  origin          PartOrigin?
  condition       Condition
  priceHalalas    Int
  quantity        Int             @default(1)
  warrantyMonths  Int             @default(0)
  dispatchDaysMin Int             @default(0)
  dispatchDaysMax Int             @default(1)
  note            String?
  photoKey        String?
  validUntil      DateTime
  status          PartQuoteStatus @default(ACTIVE)
  offerId         String?         @unique
  createdById     String?
  acceptedAt      DateTime?
  withdrawnAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  request PartRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offer   Offer?      @relation(fields: [offerId], references: [id])

  @@unique([requestId, merchantId])
  @@index([merchantId, status])
  @@index([status, validUntil])
}

// ───────────────────────────────────────────── organizations (workshops / fleets)
// "قطعة للورش": a workshop (or fleet) buys as an organisation. Members (OWNER > BUYER > TECHNICIAN) order on its
// behalf; an approved org can get NET_TERMS credit from Qitah's INTERNAL SANDBOX credit ledger (no financing partner
// is connected: `provider` says so). Merchants are always paid by Qitah regardless of how the workshop pays.
// User ids are plain columns so this block adds no back-relations to models other agents edit in parallel.

enum OrganizationType {
  WORKSHOP
  FLEET
}

enum OrganizationStatus {
  APPLIED
  APPROVED
  REJECTED
  SUSPENDED
}

/// Ordered OWNER > BUYER > TECHNICIAN. BUYER/OWNER may order; TECHNICIAN sees the org's orders only.
enum OrganizationRole {
  OWNER
  BUYER
  TECHNICIAN
}

enum OrganizationMemberStatus {
  /// Invited by phone; linked to the user (userId set, ACTIVE) when that phone signs in with OTP.
  INVITED
  ACTIVE
  REMOVED
}

enum OrganizationCreditStatus {
  ACTIVE
  FROZEN
}

enum WorkshopQuoteStatus {
  SENT
  APPROVED
  DECLINED
  EXPIRED
  CONVERTED
}

model Organization {
  id           String             @id @default(cuid())
  type         OrganizationType   @default(WORKSHOP)
  legalName    String
  displayName  String
  crNumber     String
  vatNumber    String?
  city         String
  district     String
  address      String
  latitude     Float?
  longitude    Float?
  contactPhone String
  status       OrganizationStatus @default(APPLIED)
  statusReason String?
  createdById  String
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  members    OrganizationMember[]
  credit     OrganizationCredit?
  repayments OrganizationRepayment[]
  quotes     WorkshopQuote[]
  orders     Order[]

  @@index([status, createdAt])
  @@index([crNumber])
}

model OrganizationMember {
  id           String                   @id @default(cuid())
  orgId        String
  /// Null while the invite is pending.
  userId       String?
  /// Phone the member was invited with (+9665XXXXXXXX); null for the founding OWNER.
  invitedPhone String?
  role         OrganizationRole
  status       OrganizationMemberStatus @default(ACTIVE)
  invitedById  String?
  joinedAt     DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  org          Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@unique([orgId, invitedPhone])
  @@index([userId, status])
  @@index([invitedPhone, status])
}

/// Qitah's INTERNAL credit line for the sandbox (no external financing partner). Outstanding = the org's
/// CUSTOMER_RECEIVABLE ledger balance; the row is locked FOR UPDATE by every NET_TERMS checkout.
model OrganizationCredit {
  id           String                   @id @default(cuid())
  orgId        String                   @unique
  limitHalalas Int
  termsDays    Int                      @default(30)
  status       OrganizationCreditStatus @default(ACTIVE)
  provider     String                   @default("qitah-internal-sandbox")
  approvedById String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  org          Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// A repayment recorded by Qitah finance (bank transfer received outside Qitah). Allocated oldest-due first:
/// [{orderId, amountHalalas}], one CREDIT_REPAYMENT ledger posting per allocated order.
model OrganizationRepayment {
  id             String       @id @default(cuid())
  orgId          String
  amountHalalas  Int
  idempotencyKey String       @unique
  reference      String?
  note           String?
  allocation     Json         @default("[]")
  recordedById   String?
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

/// "عرض سعر للعميل": a workshop's price proposal to its own customer, shared through an unguessable link
/// (only the SHA-256 of the token is stored). Parts are priced at the Qitah price; labour and the workshop's
/// margin (`markupHalalas`) are shown TRANSPARENTLY as their own lines ("أجرة اليد" / "رسوم الورشة").
/// Approval converts it into a workshop order (Order.workshopQuoteId) bought at Qitah prices.
model WorkshopQuote {
  id              String              @id @default(cuid())
  number          String              @unique
  orgId           String
  createdByUserId String
  /// The workshop's delivery address (owned by createdByUserId), used when the quote is converted.
  addressId       String
  /// {plate?, vin?, model, year?} exactly as the workshop typed it.
  vehicle         Json
  /// [{offerId, productId, nameAr, nameEn, brand, partNumber, condition, quantity, unitPriceHalalas}]
  lines           Json
  partsHalalas    Int
  laborHalalas    Int                 @default(0)
  markupHalalas   Int                 @default(0)
  totalHalalas    Int
  note            String?
  /// For sharing (WhatsApp) only; never shown on the public page.
  customerPhone   String?
  tokenHash       String              @unique
  expiresAt       DateTime
  status          WorkshopQuoteStatus @default(SENT)
  respondedAt     DateTime?
  orderId         String?             @unique
  convertError    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  org             Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([status, expiresAt])
}

// ───────────────────────────────────────────── merchant economics
// Commission rules, automatic settlement with an early-payout reserve, and job idempotency marks.
// Merchant/category ids are plain columns (validated in services/commission.ts) so this block adds no
// back-relations to models other agents edit in parallel. Fields added to existing models are marked
// "merchant economics" in place (Merchant, Offer, OrderItem, Payment, Settlement, SettlementLine).

enum SettlementCadence {
  WEEKLY
  DAILY
}

enum SettlementLineKind {
  SALE
  RESERVE_RELEASE
}

enum CommissionChannel {
  B2C
  B2B
  ANY
}

/// Commission tier. NULL dimensions match anything; the most specific active rule wins (see domain/commission.ts).
model CommissionRule {
  id          String            @id @default(cuid())
  name        String
  merchantId  String?
  categoryId  String?
  origin      PartOrigin?
  condition   Condition?
  channel     CommissionChannel @default(ANY)
  bps         Int
  priority    Int               @default(0)
  active      Boolean           @default(true)
  validFrom   DateTime?
  validTo     DateTime?
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([active, merchantId])
}

/// Insert-first idempotency for scheduled jobs: one row per (job, scope, period), e.g.
/// "settlement:<merchantId>:2026-10-25" or "stale-reminder:<merchantId>:2026-10-28".
model JobRunMark {
  key       String   @id
  result    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ═════════════════════════════════════════════ BEGIN catalog read model (scale) ═════════════════════════════════════════════
// One row per product, derived ONLY from offers that pass `publicOfferWhere` (services/catalog.ts).
// Kept current in the same transaction as offer / stock / merchant / location changes by
// `refreshListings()` (services/listings.ts); a worker sweep and `npm run db:backfill-listings` are the
// safety net (e.g. for time-based visibility rules). Search, home starter packs, the snapshot and the
// `/v1/catalog/changes` feed read it instead of joining Offer × Merchant × PickupLocation × InventoryLevel
// per candidate product. No relations on purpose: this block adds no back-relations to other models.

model ProductListing {
  productId              String        @id
  /// Copy of Product.status at refresh time.
  status                 ProductStatus
  /// status = ACTIVE and at least one public offer: the product can appear in public listings.
  listed                 Boolean       @default(false)
  categoryId             String
  brand                  String
  origin                 PartOrigin
  /// The product has a by-specification ("universal") note.
  universal              Boolean       @default(false)
  hasCatalogFitment      Boolean       @default(false)
  offerCount             Int           @default(0)
  inStockOfferCount      Int           @default(0)
  totalAvailable         Int           @default(0)
  /// Delivered-relevant best price: the cheapest IN-STOCK public offer, else the cheapest public offer.
  minPriceHalalas        Int?
  /// Cheapest public offer regardless of stock (search price sort without the in-stock filter).
  minOfferPriceHalalas   Int?
  minInStockPriceHalalas Int?
  minDispatchDays        Int?
  minInStockDispatchDays Int?
  conditions             Condition[]
  inStockConditions      Condition[]
  merchantIds            String[]
  originCities           String[]
  /// Compact per-offer summary [{id,m,c,p,a,d}] for searches filtered by condition or merchant.
  offers                 Json          @default("[]")
  /// md5 over every presented public-offer field: changes whenever anything a client caches changes.
  offersHash             String        @default("")
  /// Exploded fitment keys by source (`fitKeys` in services/listings.ts): one GIN array overlap answers
  /// "fits this vehicle / model / make" for search instead of an EXISTS over ProductFitment per candidate.
  catalogFitKeys         String[]      @default([])
  sellerFitKeys          String[]      @default([])
  /// Next instant a public offer of this product turns stale or hidden by time alone (offer freshness policy,
  /// domain/freshness.ts); the worker re-derives listings once it has passed.
  nextChangeAt           DateTime?
  /// Bumped only when a derived value actually changed (drives `/v1/catalog/changes`).
  updatedAt              DateTime      @default(now())

  /// Home "featured" (top products per category) and the universal-only variant for a vehicle.
  @@index([listed, categoryId, offerCount(sort: Desc)])
  @@index([listed, universal, categoryId, offerCount(sort: Desc)])
  @@index([updatedAt])
  @@index([nextChangeAt])
  @@index([merchantIds], type: Gin)
  @@index([catalogFitKeys], type: Gin)
  @@index([sellerFitKeys], type: Gin)
}
// ═════════════════════════════════════════════ END catalog read model (scale) ═══════════════════════════════════════════════
