generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum MerchantStatus { PENDING APPROVED SUSPENDED }
enum OrderStatus { AWAITING_PAYMENT PAID FULFILLING SHIPPED DELIVERED CANCELLED REFUNDED }
enum SuborderStatus { NEW ACCEPTED PACKING READY HANDED_OFF DELIVERED REJECTED }
enum ShipmentStatus { DRAFT LABEL_CREATED PICKUP_REQUESTED PICKED_UP IN_TRANSIT DELIVERED EXCEPTION RETURNING RETURNED }
enum ReturnStatus { REQUESTED APPROVED REJECTED IN_TRANSIT INSPECTING REFUNDED CLOSED }
model Merchant {
 id String @id @default(cuid())
 name String
 status MerchantStatus @default(PENDING)
 createdAt DateTime @default(now())
 locations PickupLocation[]
 offers Offer[]
 suborders MerchantSuborder[]
}
model PickupLocation {
 id String @id @default(cuid())
 merchantId String
 name String
 city String
 address String
 merchant Merchant @relation(fields:[merchantId],references:[id])
 offers Offer[]
 shipments Shipment[]
}
model Product {
 id String @id @default(cuid())
 titleAr String
 sku String @unique
 category String
 fitmentJson Json
 offers Offer[]
}
model Offer {
 id String @id @default(cuid())
 productId String
 merchantId String
 locationId String
 priceHalalas Int
 stock Int
 active Boolean @default(true)
 product Product @relation(fields:[productId],references:[id])
 merchant Merchant @relation(fields:[merchantId],references:[id])
 location PickupLocation @relation(fields:[locationId],references:[id])
 orderItems OrderItem[]
 @@index([productId,active])
}
model Customer {
 id String @id @default(cuid())
 phone String @unique
 name String?
 orders Order[]
}
model Order {
 id String @id @default(cuid())
 customerId String
 status OrderStatus @default(AWAITING_PAYMENT)
 subtotalHalalas Int
 shippingHalalas Int
 totalHalalas Int
 idempotencyKey String @unique
 createdAt DateTime @default(now())
 customer Customer @relation(fields:[customerId],references:[id])
 items OrderItem[]
 suborders MerchantSuborder[]
 payments PaymentEvent[]
 returns ReturnCase[]
}
model OrderItem {
 id String @id @default(cuid())
 orderId String
 offerId String
 quantity Int
 unitPriceHalalas Int
 order Order @relation(fields:[orderId],references:[id])
 offer Offer @relation(fields:[offerId],references:[id])
}
model MerchantSuborder {
 id String @id @default(cuid())
 orderId String
 merchantId String
 status SuborderStatus @default(NEW)
 order Order @relation(fields:[orderId],references:[id])
 merchant Merchant @relation(fields:[merchantId],references:[id])
 shipments Shipment[]
}
model Shipment {
 id String @id @default(cuid())
 suborderId String
 locationId String
 status ShipmentStatus @default(DRAFT)
 carrierRef String?
 trackingNumber String?
 shippingHalalas Int
 suborder MerchantSuborder @relation(fields:[suborderId],references:[id])
 location PickupLocation @relation(fields:[locationId],references:[id])
 events ShipmentEvent[]
}
model ShipmentEvent {
 id String @id @default(cuid())
 shipmentId String
 status ShipmentStatus
 note String?
 createdAt DateTime @default(now())
 shipment Shipment @relation(fields:[shipmentId],references:[id])
}
model PaymentEvent {
 id String @id @default(cuid())
 orderId String
 providerEventId String @unique
 status String
 amountHalalas Int
 createdAt DateTime @default(now())
 order Order @relation(fields:[orderId],references:[id])
}
model ReturnCase {
 id String @id @default(cuid())
 orderId String
 reason String
 status ReturnStatus @default(REQUESTED)
 createdAt DateTime @default(now())
 order Order @relation(fields:[orderId],references:[id])
}
model AuditEvent {
 id String @id @default(cuid())
 actor String
 action String
 entityId String
 payload Json?
 createdAt DateTime @default(now())
}
