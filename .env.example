# Qitah — environment variables (copy to .env.local; never commit real values).
# Milestone 1 runs entirely on bundled sample data and simulated services, so none are required.
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the app bundle — never put secrets in them.

# Future marketplace API (catalog, offers, orders)
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Toggle simulated payments / logistics adapters (true until real contracts exist)
EXPO_PUBLIC_USE_MOCK_SERVICES=true

# Payment / logistics provider credentials belong on the server, NOT in the app.
