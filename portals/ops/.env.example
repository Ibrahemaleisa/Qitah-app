# Qitah Ops Portal — server-side configuration. Copy to .env.local for local development.
# None of these are exposed to the browser (no NEXT_PUBLIC_ variables). Never commit real values.

# Base URL of the Qitah API (services/api). Server-only: the browser talks to /api/proxy on this app.
API_BASE_URL=http://127.0.0.1:4102

# Authentication mode — must match the API's AUTH_MODE.
#   local   : POST /v1/auth/login on the API (development / sandbox only; the API refuses local auth in production)
#   cognito : server-side Amazon Cognito InitiateAuth (USER_PASSWORD_AUTH); the Cognito ID token is used as the Bearer token
AUTH_MODE=local

# Required when AUTH_MODE=cognito. The app client must allow USER_PASSWORD_AUTH, and its client id must be listed
# in the API's COGNITO_CLIENT_IDS. COGNITO_CLIENT_SECRET only if the app client has a secret (kept server-side).
COGNITO_REGION=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Optional: public origin(s) of this portal, comma-separated (e.g. https://ops.qitah.sa). When set, mutating
# requests must carry exactly one of these Origins (CSRF check). When unset, the Origin host must equal the Host header.
APP_ORIGIN=

# Session cookies are always httpOnly + SameSite=Strict, and Secure when NODE_ENV=production.
# Set to true to force Secure cookies elsewhere (e.g. a TLS staging environment running `next dev`).
COOKIE_SECURE=false
