# Qitah Merchant Portal — server-side configuration.
# Copy to .env.local for local development. None of these are exposed to the browser
# (no NEXT_PUBLIC_ prefix): the browser only ever talks to this app's /api routes.

# Base URL of the Qitah API (services/api). Server-only.
API_BASE_URL=http://127.0.0.1:4101

# "local" (email + password against the Qitah API) or "cognito" (Amazon Cognito USER_PASSWORD_AUTH).
AUTH_MODE=local

# Required when AUTH_MODE=cognito. The app client must allow USER_PASSWORD_AUTH and REFRESH_TOKEN_AUTH.
# COGNITO_REGION=me-central-1
# COGNITO_CLIENT_ID=
# Only if the app client has a secret (public clients are recommended for this flow):
# COGNITO_CLIENT_SECRET=

# Session cookies are always httpOnly + SameSite=Lax. They are Secure when NODE_ENV=production.
# Set COOKIE_SECURE=false ONLY to run a production build over plain http on a developer machine.
# COOKIE_SECURE=false

# Extra origins accepted by the CSRF check for mutating requests, comma-separated
# (for example when the portal sits behind a proxy that rewrites the Host header).
# By default only the request's own Host is accepted.
# ALLOWED_ORIGINS=https://merchant.qitah.sa

# Verification documents are PUT by the browser directly to the signed upload URL from the API
# (S3 in AWS: the bucket's CORS must allow PUT from the portal origin). If that direct PUT fails,
# the portal relays the file through /api/upload, which only forwards to the API's own origin plus
# these extra origins (e.g. the API's public URL when it differs from API_BASE_URL), comma-separated.
# UPLOAD_RELAY_ORIGINS=https://api.qitah.sa
